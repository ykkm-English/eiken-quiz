let totalScore = 0;
let correctCount = 0;
let totalQ = 0;
const answered = {};

function addScore(id, pt) {
  if (answered[id]) return;
  answered[id] = true;
  totalScore += pt; correctCount++;
  document.getElementById('totalScore').textContent = totalScore;
  document.getElementById('correctCount').textContent = correctCount;
}

/* ==============================
   SPEECH
============================== */
let enVoice = null;
function loadVoices(){
  const voices = window.speechSynthesis.getVoices();
  for(const lang of ['en-US','en-GB','en-AU','en']){
    const v = voices.find(v => v.lang.startsWith(lang) && !v.name.includes('Japanese'));
    if(v){ enVoice = v; break; }
  }
  if(!enVoice) enVoice = voices.find(v => v.lang.toLowerCase().startsWith('en')) || null;
}
if(window.speechSynthesis){
  window.speechSynthesis.onvoiceschanged = loadVoices;
  loadVoices();
}
function speak(text){
  if(!window.speechSynthesis) return;
  window.speechSynthesis.cancel();
  const u = new SpeechSynthesisUtterance(text);
  u.lang = 'en-US';
  if(enVoice) u.voice = enVoice;
  u.rate = 0.85; u.pitch = 1.0;
  window.speechSynthesis.speak(u);
}

/* ==============================
   SOUND
============================== */
let audioCtx = null;
function getACtx(){ if (!audioCtx) audioCtx = new (window.AudioContext||window.webkitAudioContext)(); return audioCtx; }
function playOK(){
  try{
    const c=getACtx();
    [523.25,783.99].forEach((f,i)=>{
      const o=c.createOscillator(), g=c.createGain();
      o.connect(g); g.connect(c.destination);
      o.type='sine'; o.frequency.value=f;
      g.gain.setValueAtTime(0,c.currentTime+i*.15);
      g.gain.linearRampToValueAtTime(.08,c.currentTime+i*.15+.03);
      g.gain.exponentialRampToValueAtTime(.001,c.currentTime+i*.15+.5);
      o.start(c.currentTime+i*.15); o.stop(c.currentTime+i*.15+.51);
    });
  }catch(e){}
}
function playNG(){
  try{
    const c=getACtx(), o=c.createOscillator(), g=c.createGain();
    o.connect(g); g.connect(c.destination); o.type='sine';
    o.frequency.setValueAtTime(260,c.currentTime);
    o.frequency.linearRampToValueAtTime(200,c.currentTime+.25);
    g.gain.setValueAtTime(.07,c.currentTime);
    g.gain.exponentialRampToValueAtTime(.001,c.currentTime+.28);
    o.start(c.currentTime); o.stop(c.currentTime+.29);
  }catch(e){}
}

/* ==============================
   CONFETTI
============================== */
const cc=document.getElementById('confettiCanvas');
const cctx=cc.getContext('2d');
let cParts=[],cAnim=null;
const COLS=['#2563eb','#f59e0b','#10b981','#ef4444','#8b5cf6','#fcd34d','#34d399'];
function launchConfetti(){
  cc.width=window.innerWidth; cc.height=window.innerHeight; cParts=[];
  for(let i=0;i<120;i++) cParts.push({
    x:Math.random()*cc.width, y:-10-Math.random()*100,
    w:6+Math.random()*7, h:3+Math.random()*4,
    color:COLS[Math.floor(Math.random()*COLS.length)],
    vx:(Math.random()-.5)*3, vy:2.5+Math.random()*3,
    angle:Math.random()*Math.PI*2, spin:(Math.random()-.5)*.18
  });
  if(cAnim) cancelAnimationFrame(cAnim);
  animC(); setTimeout(stopC,2500);
}
function animC(){
  cctx.clearRect(0,0,cc.width,cc.height); let alive=false;
  cParts.forEach(p=>{
    if(p.y>cc.height+20) return; alive=true;
    p.x+=p.vx; p.y+=p.vy; p.angle+=p.spin; p.vy+=.06;
    cctx.save(); cctx.translate(p.x,p.y); cctx.rotate(p.angle);
    cctx.fillStyle=p.color; cctx.fillRect(-p.w/2,-p.h/2,p.w,p.h); cctx.restore();
  });
  if(alive) cAnim=requestAnimationFrame(animC); else stopC();
}
function stopC(){ if(cAnim){cancelAnimationFrame(cAnim);cAnim=null;} cctx.clearRect(0,0,cc.width,cc.height); }

