  const disp=document.getElementById(`sd-${qi}`);
  const q=q4Data[qi];
  if(!s4placed[qi].length){ disp.innerHTML='<span class="drop-hint">↓ 単語をタップして並べよう</span>'; disp.classList.remove('has-w'); return; }
  disp.classList.add('has-w');
  disp.innerHTML=s4placed[qi].map((p,i)=>
    `<div class="sort-placed ${q.toW.includes(p.word)?'to-w':''}" onclick="removeS4(${qi},${i})">${p.word}</div>`
  ).join('');
}
function removeS4(qi,i){
  const removed=s4placed[qi].splice(i,1)[0];
  const btn=document.querySelector(`[data-qi="${qi}"][data-wi="${removed.wi}"]`);
  if(btn) btn.classList.remove('used');
  updateS4Display(qi);
}
function resetS4(qi){
  s4placed[qi]=[];
  document.querySelectorAll(`[data-qi="${qi}"]`).forEach(b=>b.classList.remove('used'));
  updateS4Display(qi);
  document.getElementById(`fb4-${qi}`).className='q-feedback';
}
function checkS4(qi){
  const q=q4Data[qi];
  const placed=s4placed[qi].map(p=>p.word);
  const fb=document.getElementById(`fb4-${qi}`);
  const correct=JSON.stringify(placed)===JSON.stringify(q.ans);
  if(correct){
    fb.className='q-feedback show ok';
    fb.innerHTML=`<div class="fb-title">🎉 正解！</div>${q.ans.join(' ')}`;
    playOK(); launchConfetti();
    addScore(`s4-${qi}`,10);
    showToast('🎉 正解！ +10pt');
    setTimeout(()=>speak(q.ans.filter(w=>w!=='.').join(' ')), 600);
  } else {
    fb.className='q-feedback show ng';
    fb.innerHTML=`<div class="fb-title">😅 惜しい！</div>正解：<strong>${q.ans.join(' ')}</strong>`;
    playNG();
  }
}

/* ==============================
   STAGE 5: 英作文
============================== */
function renderStage5(){
  const el=document.getElementById('stage5');
  el.innerHTML=q5Data.map((q,qi)=>`
    <div class="q-item">
      <div class="q-text"><span class="q-num">${qi+1}</span>${q.prompt}</div>
      <textarea class="eisaku-area" placeholder="ここに英文を書こう…" rows="2"></textarea>
      <div class="eisaku-hint">💡 ヒント：${q.hint}</div>
    </div>`).join('');
}

/* ==============================
   RESULT
============================== */
function showResult(){
  const total=q1Data.length+q2Data.length+q3Data.length+q4Data.length;
  const pct=Math.round((correctCount/total)*100);
  let medal='🔬',title='まだまだ実験中！',msg='解説タブに戻って3用法を確認しよう！';
  if(pct>=90){medal='🏆';title='博士号取得おめでとう！！';msg='完璧！元素研究所の所長に認定されました！動名詞マスター！';}
  else if(pct>=70){medal='🥇';title='動名詞マスター！';msg='すばらしい！あと少しで完璧だ！';}
  else if(pct>=50){medal='🥈';title='合格ライン突破！';msg='なかなかいい感じ！苦手なステージを復習しよう。';}
  const banner=document.getElementById('resultBanner');
  document.getElementById('rMedal').textContent=medal;
  document.getElementById('rTitle').textContent=title;
  document.getElementById('rScore').textContent=`${totalScore}pt (${pct}%)`;
  document.getElementById('rMsg').textContent=msg;
  banner.classList.add('show');
  banner.scrollIntoView({behavior:'smooth'});
  if(pct>=70){ playOK(); launchConfetti(); }
}

/* ==============================
   OVERLAY PEN
============================== */
const oc=document.getElementById('overlayCanvas');
const octx=oc.getContext('2d');
let penActive=false,oDrawing=false,oPenColor='#2563eb',oPenSize=2,oTool='pen',oLX=0,oLY=0;
function resizeOverlay(){ oc.width=window.innerWidth; oc.height=window.innerHeight; }
function togglePen(){
  penActive=!penActive;
  oc.classList.toggle('pen-active',penActive);
  document.getElementById('penToggle').classList.toggle('active',penActive);
  document.getElementById('penToggle').textContent=penActive?'✕':'✏️';
  document.getElementById('penPanel').classList.toggle('open',penActive);
}
function getOP(e){ if(e.touches) return{x:e.touches[0].clientX,y:e.touches[0].clientY}; return{x:e.clientX,y:e.clientY}; }
oc.addEventListener('mousedown',e=>{oDrawing=true;const p=getOP(e);oLX=p.x;oLY=p.y;});
oc.addEventListener('mousemove',e=>{if(!oDrawing)return;const p=getOP(e);drawO(oLX,oLY,p.x,p.y);oLX=p.x;oLY=p.y;});
oc.addEventListener('mouseup',()=>oDrawing=false);
oc.addEventListener('mouseleave',()=>oDrawing=false);
oc.addEventListener('touchstart',e=>{e.preventDefault();oDrawing=true;const p=getOP(e);oLX=p.x;oLY=p.y;},{passive:false});
oc.addEventListener('touchmove',e=>{e.preventDefault();if(!oDrawing)return;const p=getOP(e);drawO(oLX,oLY,p.x,p.y);oLX=p.x;oLY=p.y;},{passive:false});
oc.addEventListener('touchend',()=>oDrawing=false);
function drawO(x1,y1,x2,y2){
  octx.beginPath();octx.moveTo(x1,y1);octx.lineTo(x2,y2);
  octx.strokeStyle=oTool==='eraser'?'rgba(255,255,255,0.95)':oPenColor;
  octx.lineWidth=oTool==='eraser'?oPenSize*6:oPenSize;
  octx.lineCap='round';octx.lineJoin='round';octx.stroke();
}
function setPenColor(el){
  document.querySelectorAll('.pen-color').forEach(c=>c.classList.remove('active'));
  el.classList.add('active');oPenColor=el.dataset.color;oTool='pen';
  document.getElementById('penBtn').classList.add('active');
  document.getElementById('eraserBtn').classList.remove('active');
}
function setPenSize(el){
  document.querySelectorAll('.pen-size').forEach(c=>c.classList.remove('active'));
  el.classList.add('active');oPenSize=parseInt(el.dataset.size);
}
function setOverlayTool(t){
  oTool=t;
  document.getElementById('penBtn').classList.toggle('active',t==='pen');
  document.getElementById('eraserBtn').classList.toggle('active',t==='eraser');
}
function clearOverlay(){ octx.clearRect(0,0,oc.width,oc.height); }

/* ==============================
   TOAST
============================== */
let toastT;
function showToast(msg){
  const t=document.getElementById('toast');
  t.textContent=msg; t.classList.add('show');
  clearTimeout(toastT); toastT=setTimeout(()=>t.classList.remove('show'),2200);
}

/* ==============================
   INIT
============================== */
window.addEventListener('load',()=>{
  resizeOverlay();
  renderStage1();
  renderStage2();
  renderStage3();
  renderStage4();
  renderStage5();
});
window.addEventListener('resize',resizeOverlay);
</script>
